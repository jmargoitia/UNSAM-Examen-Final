#-------------- PCA --------------

## Estructura latente para diferenciación----

# Construimos la receta con total de predictores y calculamos resultados

pca_recipe <- atlas %>% 
  select(edu_fin_secundaria:tic_celular) %>% 
  recipe(~.) %>%
  step_normalize(all_numeric()) %>%
  step_pca(all_numeric(), num_comp=17)

pca_recipe

pca_estimates <-  prep(pca_recipe)

# Evaluamos varianza para seleccionar componentes sobre las cuales clusterizar
tidy(pca_estimates, 2, type="variance") %>%
  filter(terms=="percent variance") %>%
  mutate(component= factor(paste0("PC", component),
                           levels=paste0("PC", 1:17))) %>%
  ggplot(aes(x=component,y=value,group=terms)) +
  geom_col() +
  geom_text(aes(label = round(value, 2)), vjust = -0.3, size = 2.5) +
  scale_y_continuous(limits = c(0, 105), breaks = seq(0, 100, by = 20)) +
  labs(title="% varianza",
       x="Componente",
       y="Valor") + 
  theme_minimal() +
  
  tidy(pca_estimates, 2, type="variance") %>%
  filter(terms=="cumulative percent variance") %>%
  mutate(component= factor(paste0("PC", component),
                           levels=paste0("PC", 1:17))) %>%
  ggplot(aes(x=component,y=value,group=terms)) +
  geom_col() +
  geom_text(aes(label = round(value, 2)), vjust = -0.3, size = 2.5) +
  scale_y_continuous(limits = c(0, 105), breaks = seq(0, 100, by = 20)) +
  labs(title="% varianza acum.",
       x="Componente",
       y="Valor") + 
  theme_minimal()

## Evaluamos cargas factoriales---- 
# Retenemos 5 componentes principales que explican casi tres cuartos (73.3%) de la varianza acumulada
# - Es un rango de componentes con claridad conceptual y relevancia analítica de brechas territoriales
# - Trade off: sumar PC6 y PC7 permite superar el 80% de varianza acumulada, pero hay superposición interpretativa con PC3 y PC4

tidy(pca_estimates, 2, type="coef") %>%
  filter(component %in% paste0("PC", 1:7)) %>%
  mutate(component = factor(component, 
                            levels = paste0("PC", 1:7)),
         direccion = ifelse(value>0, "Negativa", "Positiva")) %>% 
  ggplot(aes(value, terms, fill=direccion)) +
  geom_col(show.legend = FALSE) +
  geom_text(aes(label=round(value,2))) +
  geom_vline(xintercept = 0, linetype = "dashed") +
  scale_fill_manual(values = c("Negativa" = "#51127c", "Positiva" = "#fb8861")) +
  xlim(-1.1, 1.1) +
  labs(title="Cargas factoriales (comp. 1-7)",
       x="Carga",
       y="Variable") + 
  facet_wrap(~component, nrow=1) +
  theme_minimal()

## Insumo para el clustering----
# Estimamos nuevamente el PCA ahora con dimensionalidad reducida a 5 componentes principales
# Sumamos nuevo objeto con identificadores municipales para potenciales interpretaciones

pca_recipe_final <- atlas %>% 
  select(edu_fin_secundaria:tic_celular) %>% 
  recipe(~.) %>%
  step_normalize(all_numeric()) %>%
  step_pca(all_numeric(), num_comp=5)

pca_estimates_final <-  prep(pca_recipe_final) #input K-means
pca_data <- bake(pca_estimates_final, new_data = NULL) # input HC



#-------------- CLUSTERING --------------

## K-means----

# Método del codo
# Fijamos semilla para reproducibilidad
set.seed(123)

# Generamos vector de clusters a explorar
centers <- 1:10

# Inicializamos tibbles vacías para llenar con asignaciones de clusters y métricas de calidad
km_assignments <- tibble()
km_clusterings <- tibble()

# Iteramos sobre cada valor de k
# Parámetro nstart = 25 para evitar sesgo de única inicialización aleatoria de centroides
for (i in centers) {
  
  km <- pca_recipe_final %>%
    prep() %>%
    bake(new_data = NULL) %>%
    select(starts_with("PC")) %>%
    kmeans(x = ., centers = i, nstart = 25)
  
  # glance: extraemos métricas de variabilidad intra/extracluster
  km_clusterings <- km_clusterings %>%
    bind_rows(
      glance(km) %>%
        mutate(k = i) %>%
        select(k, everything()))
  
  # augment: asignaciones de clusters
  km_assignments <- km_assignments %>%
    bind_rows(
      augment(km, atlas) %>%
        mutate(k = i) %>%
        select(k, everything()))
}

km_clusterings
km_assignments

# Graficamos el método del codo
# Razonable optar por k =  4 o k = 5 (no es nítido el punto donde se aplana la caída de variabilidad)
ggplot(km_clusterings, aes(x=as.factor(k), y=tot.withinss, group=1)) +
  geom_line() +
  geom_point() +
  labs(title = "Método del codo: K-means",
       x="Cantidad clústers (k)",
       y="Variabilidad intra-cluster (WCV)") +
  theme_minimal()

# Por sugerencia de la IA Claude, calculamos la reducción porcentual de WCV con cada k
# Confirmamos que a partir de k = 4 se aplana la curva (las reducciones empiezan a moderarse)
km_clusterings <- km_clusterings %>%
  arrange(k) %>%
  mutate(reduccion_WCV = (lag(tot.withinss) - tot.withinss) / lag(tot.withinss) * 100,
         aumento_BCV = (betweenss - lag(betweenss)) / totss * 100)
km_clusterings

ggplot(km_clusterings, aes(x=as.factor(k), y=tot.withinss, group=1)) +
  geom_line() +
  geom_point() +
  geom_vline(xintercept = c(4), linetype="dashed", , color="red", linewidth = 0.7) +
  labs(title = "Método del codo: K-means",
       x="Cantidad clústers (k)",
       y="Variabilidad intra-cluster (WCV)") +
  theme_minimal()


## Hierarchical Clustering----

# Calculamos matriz de distancias. Por convención:
# Distancia euclidiana (Manhtann más sensible a outliers que no controlamos)
# Método ward.D2 de vinculación (para priorizar minimización de WCV)
dist <- pca_data %>%
  select(starts_with("PC")) %>%
  dist(method = "euclidean")

hc <- hclust(dist, method = "ward.D2")

# Graficamos el dendograma
# El corte más razonable sigue siendo de 4 clusters
# Vemos que el siguiente salto natural el corte en k = 6 o k = 8 clusters (no 5 como vimos con K-means)
dhc <- as.dendrogram(hc)
hc_data <- dendro_data(dhc, type = "rectangle")

ggplot(segment(hc_data)) + 
  geom_segment(aes(x = x, y = y, xend = xend, yend = yend)) + 
  coord_flip() + 
  scale_y_reverse(expand = c(0.2, 0)) +
  geom_hline(yintercept= c(60), linetype="dashed", color="red", linewidth = 0.7) +
  labs(title = "Matriz de disimilitud: clustering jerárquico ('ward.D2')",
       x="Municipios",
       y="Distancia") +
  theme_minimal()


## Interpretación----


## Analizamos y comparamos clusters por método

# Recuperamos base Atlas y asignamos clusters con k = 4

hc4 <- cutree(hc, k = 4)

atlas_clusters_4 <- km_assignments %>%
  filter(k == 4) %>%
  select(-k) %>%
  rename(km_cluster = .cluster) %>% 
  mutate(km_cluster = droplevels(km_cluster),
         hc_cluster = as.factor(hc4))
 
# Graficamos comportamiento de variables (KM vs HC)
atlas_clusters_4 %>%
  select(km_cluster, edu_fin_secundaria:tic_celular) %>%
  pivot_longer(cols = -c(km_cluster)) %>%
  ggplot(aes(y = value, fill = km_cluster)) +
  geom_boxplot() +
  theme_minimal() +
  theme(axis.title.x = element_blank(),
        axis.text.x = element_blank(),
        axis.ticks.x = element_blank()) +
  facet_wrap(~ name, scales = "free_y") +
  labs(title = "Comportamiento de variables por cluster: K-means (k=4)",
       fill = "Cluster")

atlas_clusters_4 %>%
  select(hc_cluster, edu_fin_secundaria:tic_celular) %>%
  pivot_longer(cols = -c(hc_cluster)) %>%
  ggplot(aes(y = value, fill = as.factor(hc_cluster))) +
  geom_boxplot() +
  facet_wrap(~ name, scales = "free_y") +
  labs(title = "Comportamiento de variables por cluster: Jerárquico (k=4)",
       fill = "Cluster") +
  theme_minimal() +
  theme(axis.title.x = element_blank(),
        axis.text.x = element_blank(),
        axis.ticks.x = element_blank())

# Recodificamos clusters del método jerárquico con perfiles similares al kmeans
atlas_clusters_4 <- atlas_clusters_4 %>%
  mutate(hc_cluster_recod = case_when(hc_cluster == 1 ~ 2,
                                      hc_cluster == 2 ~ 4,
                                      hc_cluster == 3 ~ 1,
                                      hc_cluster == 4 ~ 3))

# Volvemos a graficar comportamiento de variables para el método jerárquico
atlas_clusters_4 %>%
  select(hc_cluster_recod, edu_fin_secundaria:tic_celular) %>%

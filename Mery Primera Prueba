#-------------- PREPARACIÓN --------------
# Cargamos librerías
library(tidyverse)
library(readr)
library(ggplot2)
library(corrplot)
library(ggcorrplot)
library(tidymodels)
library(patchwork)
library(GDAtools)
library(ggdendro)

# Importamos base Atlas de CAF
atlas <- read_csv("data/m4_atlas_argentina.csv")



#-------------- EXPLORACION y LIMPIEZA --------------
# Exploramos estructura de la base y comportamiento general de las variables
atlas %>% 
  glimpse() %>% 
  summary()

# Confirmamos que los data points son únicos (jurisdicción y año)
# Sumamos hogares y población: se verifica que hay superposición de niveles de gobierno por desfasaje con Censo
n_distinct(atlas$codigo_unico, na.rm = TRUE)
n_distinct(atlas$codigo_pais, na.rm = TRUE)
n_distinct(atlas$poblacion_anio, na.rm = TRUE)

atlas %>% 
  select(nombre_nivel, nivel_gobierno, codigo_nivel) %>% 
  table()

# Descartamos jurisdicciones provinciales: nos quedamos con 2320 obs
# Corroboramos el agregado de población y hogares se acerca al Censo 2022
colnames(atlas)
atlas <- atlas %>%
  filter(codigo_nivel == 2) %>% 
  select(1,5:6,9:11,13:31)

atlas %>% 
  select(poblacion, hogares) %>% 
  summarise(pob_tot = sum(poblacion, na.rm = TRUE),
            hogares_tot = sum(hogares, na.rm = TRUE))

## Reestructuramos variables de interés----
# Factorizamos variable dummy (ODS), invertimos variables negativas, categorizamos y ordenamos
colnames(atlas)

atlas <- atlas %>% 
  mutate(tiene_ods = factor(tiene_ods,
                            levels = c(0,1),
                            labels = c("No","Si")))

atlas <- atlas %>%
  mutate(alfabetismo = 1-analfabetismo) %>%
  select(-analfabetismo) %>% 
  rename(
    # Identificadores
    id_codigo_unico = codigo_unico,
    id_nombre_subnacional = nombre_subnacional,
    id_gob_regional = gob_regional,
    id_gob_local = gob_local,
    # Categóricas
    cat_nombre_nivel = nombre_nivel,
    cat_ods = tiene_ods,
    # Numéricas base
    num_hogares = hogares,
    num_poblacion = poblacion,
    # Educación
    edu_alfabetismo = alfabetismo,
    edu_fin_secundaria = fin_secundaria_adultos,
    # Mercado laboral
    ml_participacion_mujer = participacion_mujeres,
    ml_participacion_hombre = participacion_hombres,
    ml_desempleo = desempleo_adulto,
    ml_desempleo_mujer = desempleo_adulto_mujer,
    ml_desempleo_hombre = desempleo_adulto_hombre,
    ml_empleo_publico = empleo_publico_categoria,
    # Servicios básicos
    sb_agua = agua_mejorada,
    sb_saneamiento = saneamiento_mejorado,
    sb_electricidad = electricidad,
    sb_recoleccion = recoleccion_residuos,
    # Demográficas
    demo_urbano = urbano,
    demo_indigena = etnia_indigena,
    demo_afro = etnia_afro,
    # Tecnologías de la información y la comunicación
    tic_computadora = tics_computadora,
    tic_celular = tics_celular)

atlas <- atlas %>% 
  select(starts_with("id_"),
         starts_with("cat_"),
         starts_with("num_"),
         starts_with("edu_"),
         starts_with("ml_"),
         starts_with("sb_"),
         starts_with("demo_"),
         starts_with("tic_"))

## Verificamos NAs (por variables y por municipio)----

tabla_nas_vars <- atlas %>%
  summarise(across(everything(), ~sum(is.na(.)))) %>%
  pivot_longer(everything(), names_to = "variable", values_to = "total_nas") %>%
  mutate(porcentaje = (total_nas / nrow(atlas)) * 100) %>%
  arrange(desc(total_nas))

tabla_nas_munis <- atlas %>%
  mutate(total_nas = rowSums(is.na(select(., starts_with("edu_"),
                                          starts_with("ml_"),
                                          starts_with("sb_"),
                                          starts_with("demo_"),
                                          starts_with("tic_"))))) %>%
  count(total_nas, name = "munis") %>%
  mutate(porcentaje = (munis / nrow(atlas)) * 100) %>%
  arrange(desc(total_nas))

atlas <- atlas %>%
  mutate(total_nas = rowSums(is.na(select(., starts_with("edu_"),
                                          starts_with("ml_"),
                                          starts_with("sb_"),
                                          starts_with("demo_"),
                                          starts_with("tic_"))))) %>%
  filter(total_nas<16) %>% 
  select(-total_nas)

atlas <- atlas %>%
  mutate(across(9:25, ~ifelse(is.na(.), median(., na.rm = TRUE), .)))

colSums(is.na(atlas))



#-------------- PREPROCESAMIENTO --------------
## Dispersión de los datos----

# Graficamos desvío estándar para mejor visualización de los datos (sin población y hogares)
# Tabulamos distribución de los desvíos para observar dónde hacer los cortes de las categorías
tabla_dispersion <- atlas %>%
  summarise(across(where(is.numeric), ~sd(., na.rm = TRUE))) %>%
  pivot_longer(everything(), names_to = "variable", values_to = "desviacion_estandar") %>%
  arrange(desc(desviacion_estandar))

distribucion_desvios <- atlas %>%
  summarise(across(where(is.numeric), ~sd(., na.rm = TRUE))) %>%
  pivot_longer(everything(), names_to = "variable", values_to = "desviacion") %>%
  filter(!variable %in% c("num_poblacion", "num_hogares"))

summary(distribucion_desvios$desviacion)

# Clasificación basada en los cuartiles de la base
desvios_categorizados <- distribucion_desvios %>%
  mutate(categoria = case_when(
    desviacion >= 0.1963 ~ "Alta",
    desviacion <= 0.0649 ~ "Baja",
    TRUE                 ~ "Media"), 
    categoria = factor(categoria, levels = c("Alta", "Media", "Baja"))) %>%
  arrange(desc(desviacion))

print(desvios_categorizados)

# Graficamos la clasificación de variables 
ggplot(desvios_categorizados, aes(x = reorder(variable, desviacion), y = desviacion, fill = categoria)) +
  geom_col() +
  coord_flip() + # Para que los nombres de las variables se lean bien
  scale_fill_manual(values = c(
    "Alta" = "#51127c",
    "Media" = "#b63679",
    "Baja" = "#fb8861"
  )) +
  labs(
    title = "Brechas territoriales en localidades argentinas",
    subtitle = "Clasificación de indicadores según su desviación estándar (N=2217)", #2320?
    x = "Indicador de bienestarl",
    y = "Desviación estándar",
    fill = "Nivel de heterogeneidad"
  ) +
  theme_minimal() +
  theme(legend.position = "bottom") 


## Matriz de correlación----

# Seleccionamos variables de bienestar
corr <- atlas %>%
  select(where(is.numeric)) %>%
  select(-num_poblacion, -num_hogares)

# Calculamos la matriz
matriz_correlacion <- cor(corr)

# Graficamos la matriz
ggcorrplot(matriz_correlacion,
           hc.order = TRUE,
           type = "lower",
           lab = TRUE,        
           lab_size = 2.5,      
           colors = c("#51127c", "white", "#fb8861"), 
           title = "Matriz de Correlación: indicadores locales de bienestar",
           ggtheme = theme_minimal()) +
  theme(axis.text.x = element_text(size = 8, angle = 90),
        axis.text.y = element_text(size = 8))




## Dispersión de los datos----

# Graficamos desvío estándar para mejor visualización de los datos (sin población y hogares)
# Tabulamos distribución de los desvíos para observar dónde hacer los cortes de las categorías
tabla_dispersion <- atlas %>%
  summarise(across(where(is.numeric), ~sd(., na.rm = TRUE))) %>%
  pivot_longer(everything(), names_to = "variable", values_to = "desviacion_estandar") %>%
  arrange(desc(desviacion_estandar))

distribucion_desvios <- atlas %>%
  summarise(across(where(is.numeric), ~sd(., na.rm = TRUE))) %>%
  pivot_longer(everything(), names_to = "variable", values_to = "desviacion") %>%
  filter(!variable %in% c("num_poblacion", "num_hogares"))

summary(distribucion_desvios$desviacion)

# Clasificación basada en los cuartiles de la base
desvios_categorizados <- distribucion_desvios %>%
  mutate(categoria = case_when(
    desviacion >= 0.1963 ~ "Alta",
    desviacion <= 0.0649 ~ "Baja",
    TRUE                 ~ "Media"), 
    categoria = factor(categoria, levels = c("Alta", "Media", "Baja"))) %>%
  arrange(desc(desviacion))

print(desvios_categorizados)

# Graficamos la clasificación de variables 
ggplot(desvios_categorizados, aes(x = reorder(variable, desviacion), y = desviacion, fill = categoria)) +
  geom_col() +
  coord_flip() + # Para que los nombres de las variables se lean bien
  scale_fill_manual(values = c(
    "Alta" = "#51127c",
    "Media" = "#b63679",
    "Baja" = "#fb8861"
  )) +
  labs(
    title = "Brechas territoriales en localidades argentinas",
    subtitle = "Clasificación de indicadores según su desviación estándar (N=2217)", #2320?
    x = "Indicador de bienestarl",
    y = "Desviación estándar",
    fill = "Nivel de heterogeneidad"
  ) +

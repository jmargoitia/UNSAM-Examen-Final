## Dispersión de los datos----

# Calculamos desvíos estándar para entender heterogeneidad de municipios (sin población y hogares que tienen otra escala)

desvios <- atlas %>%
  summarise(across(where(is.numeric), ~sd(., na.rm = TRUE))) %>%
  pivot_longer(everything(), names_to = "variable", values_to = "sd") %>%
  filter(!variable %in% c("num_poblacion", "num_hogares"))


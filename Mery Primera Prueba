  theme(axis.title.x = element_blank(),
        axis.text.x = element_blank(),
        axis.ticks.x = element_blank())

# Comparamos distribución de municipios entre clusters para cada método
# Distribuciones se asemejan: hay un cluster dominante, dos medianos (más preponderante en el jerárquico) y uno pequeño

clusters_munis <- left_join(
  atlas_clusters_4 %>% 
    count(km_cluster) %>%
    mutate(peso_km = round(n / sum(n) * 100, 1),
           cluster = as.integer(km_cluster)) %>%
    select(-km_cluster) %>%
    rename(n_km = n),
  atlas_clusters_4 %>%
    count(hc_cluster_recod) %>%
    mutate(peso_hc = round(n / sum(n) * 100, 1),
           cluster = as.integer(hc_cluster_recod)) %>%
    select(-hc_cluster_recod) %>%
    rename(n_hc = n),
  by = "cluster")

clusters_munis

# Evaluamos grado de convergencia de clusters entre métodos
# Cluster 1, 2 y 4 robustos con 90% o más de coincidencias en las asignaciones. Cluster 3 más problemático: no hay diferenciación tajante. 
# Puede haber menor cohesión de los datos o municipios agrupados son casos de "frontera" que comparten características con cluster 4
# Hay sentido metodológico en que la estructura del cluster 3 no sea tan cohesionada: 
#-Aunque sean cercanos, KM fuerza asignación por cercanía (al centroide de alto desempleo del PCA2)
#-Método de enlace Ward (HC) fuerza asignación por similitud de los datos para minimizar WCV. Con Average link podría aumentar convergencia
#-Desempleo no diferencia lo suficiente al espacio multidimensional, municipios comparten déficits que lo asemejan al cluster 4.

table(atlas_clusters_4$km_cluster, atlas_clusters_4$hc_cluster_recod)

clusters_convergencia <- atlas_clusters_4 %>% 
  count(km_cluster, hc_cluster_recod) %>% 
  pivot_wider(names_from = hc_cluster_recod,
              values_from = n,
              values_fill = 0)

clusters_convergencia
